  {{ ev.enum_value_camel_case }}('{{ ev.enum_value_key }}'){% if not loop.is_last %},{% endif %}{% if loop.is_last %};{% endif %}
  {% endfor -%}

  final String value;
  const {{ enum.enum_pascal_case }}Enum(this.value);

  @override
  String toString() => value;
}
{% endfor -%}

